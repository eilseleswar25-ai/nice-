-- Key Handling via ContextActionService
local function handleKeyAction(actionName, inputState, inputObject)
    if not active then return Enum.ContextActionResult.Pass end
    if inputObject and inputObject.KeyCode then
        local keyName = interceptedKeyCodes[inputObject.KeyCode]
        if keyName then
            local isDown = (inputState == Enum.UserInputState.Begin)
            keysDown[keyName] = isDown
        end
    end
    return Enum.ContextActionResult.Sink
end

-- Input Listeners
inputBeganConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.P and UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
        toggleBtn:Activate()
        return
    end

    if not active then return end

    if input.UserInputType == Enum.UserInputType.Touch and not gameProcessed then
        local vpSize = camera.ViewportSize
        local touchPos = Vector2.new(input.Position.X, input.Position.Y)
        
        if touchPos.X < (vpSize.X * 0.48) and not moveTouchId then
            moveTouchId = input
            joystickCenter = touchPos
            joystickFrame.Position = UDim2.new(0, touchPos.X, 0, touchPos.Y)
            joystickKnob.Position = UDim2.new(0.5, 0, 0.5, 0)
            joystickVector = Vector2.zero
            joystickFrame.Visible = true
        elseif touchPos.X >= (vpSize.X * 0.48) and not lookTouchId then
            lookTouchId = input
        end
    end
end)

inputChangedConnection = UserInputService.InputChanged:Connect(function(input, gameProcessed)
    if not active then return end

    if input.UserInputType == Enum.UserInputType.Touch then
        if input == moveTouchId then
            local currentPos = Vector2.new(input.Position.X, input.Position.Y)
            local delta = currentPos - joystickCenter
            local dist = delta.Magnitude
            if dist > joystickMaxRadius then
                delta = delta.Unit * joystickMaxRadius
            end
            joystickKnob.Position = UDim2.new(0.5, delta.X, 0.5, delta.Y)
            joystickVector = Vector2.new(delta.X / joystickMaxRadius, -delta.Y / joystickMaxRadius)
        elseif input == lookTouchId then
            local d = input.Delta
            camYaw = camYaw - (d.X * touchSensitivity)
            camPitch = math.clamp(camPitch - (d.Y * touchSensitivity), -89, 89)
        end
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement then
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            local d = input.Delta
            camYaw = camYaw - (d.X * mouseSensitivity)
            camPitch = math.clamp(camPitch - (d.Y * mouseSensitivity), -89, 89)
        end
    end
end)

inputEndedConnection = UserInputService.InputEnded:Connect(function(input)
    if input == moveTouchId then
        moveTouchId = nil
        joystickVector = Vector2.zero
        joystickFrame.Visible = false
    elseif input == lookTouchId then
        lookTouchId = nil
    end
end)

-- Freecam Lifecycle Functions
local function startFreecam()
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if not char or not hum or not root then return end

    hum:UnequipTools()
    pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false) end)

    fallingAfterTeleport = false
    originalAnchored = root.Anchored
    frozenCFrame = root.CFrame
    root.Anchored = true
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    if controls then
        controls:Disable()
    end
    
    local touchGui = player:FindFirstChild("PlayerGui") and player.PlayerGui:FindFirstChild("TouchGui")
    if touchGui then
        touchGui.Enabled = false
    end

    ContextActionService:BindActionAtPriority(
        "FreecamKeySink",
        handleKeyAction,
        false,
        Enum.ContextActionPriority.High.Value,
        Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
        Enum.KeyCode.E, Enum.KeyCode.Q, Enum.KeyCode.Space,
        Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift,
        Enum.PlayerActions.CharacterForward, Enum.PlayerActions.CharacterBackward,
        Enum.PlayerActions.CharacterLeft, Enum.PlayerActions.CharacterRight,
        Enum.PlayerActions.CharacterJump
    )

    if rememberPosition and savedPos and savedPitch and savedYaw then
        camPos = savedPos
        camPitch = savedPitch
        camYaw = savedYaw
    else
        local currentCF = camera.CFrame
        camPos = currentCF.Position
        local x, y, _ = currentCF:ToOrientation()
        camPitch = math.deg(x)
        camYaw = math.deg(y)
    end

    camera.CameraType = Enum.CameraType.Scriptable

    renderConnection = RunService.RenderStepped:Connect(function(dt)
        if char and root then
            if fallingAfterTeleport then
                local elapsed = tick() - teleportFallStartTime
                local vel = root.AssemblyLinearVelocity
                local groundParams = RaycastParams.new()
                groundParams.FilterType = Enum.RaycastFilterType.Exclude
                groundParams.FilterDescendantsInstances = { char }
                groundParams.IgnoreWater = true
                
                local castDist = (root.Size.Y / 2) + 0.35
                local groundHit = workspace:Raycast(root.Position, Vector3.new(0, -castDist, 0), groundParams)
                local touchingGround = groundHit ~= nil
                local settledVelocity = math.abs(vel.Y) < 1.5
                local timedOut = elapsed > 8

                if elapsed > 0.15 and ((touchingGround and settledVelocity) or timedOut) then
                    fallingAfterTeleport = false
                    root.Anchored = true
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    frozenCFrame = root.CFrame
                end
            else
                root.CFrame = frozenCFrame
                root.Anchored = true
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
        end

        local rotCFrame = CFrame.Angles(0, math.rad(camYaw), 0) * CFrame.Angles(math.rad(camPitch), 0, 0)
        local moveVector = Vector3.zero

        if joystickVector.Magnitude > 0.05 then
            local right = rotCFrame.RightVector * joystickVector.X
            local forward = rotCFrame.LookVector * joystickVector.Y
            moveVector = moveVector + right + forward
        end

        local kbForward = 0
        local kbRight = 0
        local kbUp = 0

        if keysDown.W then kbForward = kbForward + 1 end
        if keysDown.S then kbForward = kbForward - 1 end
        if keysDown.D then kbRight = kbRight + 1 end
        if keysDown.A then kbRight = kbRight - 1 end
        if keysDown.E then kbUp = kbUp + 1 end
        if keysDown.Q then kbUp = kbUp - 1 end

        if kbForward ~= 0 or kbRight ~= 0 or kbUp ~= 0 then
            local pcMove = (rotCFrame.LookVector * kbForward) + (rotCFrame.RightVector * kbRight) + (Vector3.new(0, 1, 0) * kbUp)
            moveVector = moveVector + pcMove
        end

        if moveVector.Magnitude > 0 then
            local currentMultiplier = keysDown.LeftShift and 2.0 or 1.0
            camPos = camPos + (moveVector.Unit * (flySpeed * currentMultiplier * dt))
        end

        camera.CFrame = CFrame.new(camPos) * rotCFrame
    end)
end

local function stopFreecam()
    if renderConnection then
        renderConnection:Disconnect()
        renderConnection = nil
    end

    ContextActionService:UnbindAction("FreecamKeySink")

    pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true) end)

    moveTouchId = nil
    lookTouchId = nil
    joystickVector = Vector2.zero
    joystickFrame.Visible = false

    if controls then
        controls:Enable()
    end
    
    local touchGui = player:FindFirstChild("PlayerGui") and player.PlayerGui:FindFirstChild("TouchGui")
    if touchGui then
        touchGui.Enabled = true
    end

    for k in pairs(keysDown) do
        keysDown[k] = false
    end

    if rememberPosition then
        savedPos = camPos
        savedPitch = camPitch
        savedYaw = savedYaw
    end

    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if hum then
        camera.CameraSubject = hum
    end

    if root then
        root.Anchored = originalAnchored
        if not fallingAfterTeleport then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end

    fallingAfterTeleport = false
    camera.CameraType = Enum.CameraType.Custom
end

