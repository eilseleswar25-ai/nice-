local function bindHoldStep(button, delta)
    local isHolding = false
    local function applyStep()
        flySpeed = math.clamp(flySpeed + delta, minSpeed, maxSpeed)
        speedLabel.Text = "SPD: " .. tostring(flySpeed)
    end
    button.MouseButton1Down:Connect(function()
        isHolding = true
        applyStep()
        task.delay(0.3, function()
            while isHolding do
                applyStep()
                task.wait(0.06)
            end
        end)
    end)
    local function release()
        isHolding = false
    end
    button.MouseButton1Up:Connect(release)
    button.MouseLeave:Connect(release)
end

bindHoldStep(speedMinus, -speedStep)
bindHoldStep(speedPlus, speedStep)

