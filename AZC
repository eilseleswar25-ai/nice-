local function animateHud(open)
    if open then
        hudFrame.Visible = true
        hudCanvasGroup.GroupTransparency = 1
        hudScale.Scale = 0.8
        runSafeTween("hud_fade", hudCanvasGroup, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { GroupTransparency = 0 })
        runSafeTween("hud_pop", hudScale, TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
    else
        local fadeTween = runSafeTween("hud_fade", hudCanvasGroup, TweenInfo.new(0.14, Enum.EasingStyle.Quart, Enum.EasingDirection.In), { GroupTransparency = 1 })
        runSafeTween("hud_pop", hudScale, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.85 })
        fadeTween.Completed:Connect(function()
            if not active then
                hudFrame.Visible = false
            end
        end)
    end
end

