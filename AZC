-- Animation Registry
local activeTweens = {}
local function runSafeTween(id, target, tweenInfo, properties)
    if activeTweens[id] then
        activeTweens[id]:Cancel()
        activeTweens[id] = nil
    end
    local tween = TweenService:Create(target, tweenInfo, properties)
    activeTweens[id] = tween
    tween.Completed:Connect(function()
        if activeTweens[id] == tween then
            activeTweens[id] = nil
        end
    end)
    tween:Play()
    return tween
end

