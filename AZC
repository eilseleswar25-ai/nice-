-- Faded Red Glass UI Constructor
local function applyGlassStyle(guiObject, bgColor, strokeColor, pillRadius, bgTransparency)
    local trans = bgTransparency or 0
    guiObject.BackgroundColor3 = bgColor or Color3.fromRGB(35, 10, 15)
    guiObject.BackgroundTransparency = trans
    guiObject.BorderSizePixel = 0

    local corner = Instance.new("UICorner")
    corner.CornerRadius = pillRadius or UDim.new(1, 0)
    corner.Parent = guiObject

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.4
    stroke.Color = strokeColor or Color3.fromRGB(220, 20, 60)
    stroke.Transparency = math.clamp(trans * 0.4, 0, 0.4)
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = guiObject

    local grad = Instance.new("UIGradient")
    grad.Rotation = 45
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.0, Color3.fromRGB(200, 25, 45)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(120, 15, 30)),
        ColorSequenceKeypoint.new(1.0, Color3.fromRGB(50, 8, 15))
    })
    grad.Transparency = NumberSequence.new(trans)
    grad.Parent = guiObject

    return stroke
end

-- Button Bounce Feedback
local function bindButtonBounce(btn, baseScale)
    baseScale = baseScale or 1
    local scale = Instance.new("UIScale")
    scale.Scale = baseScale
    scale.Parent = btn

    btn.MouseButton1Down:Connect(function()
        runSafeTween(btn, scale, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = baseScale * 0.92 })
    end)
    btn.MouseButton1Up:Connect(function()
        runSafeTween(btn, scale, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = baseScale })
    end)
end

